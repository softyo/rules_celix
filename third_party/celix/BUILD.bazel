# Package marker so the .bzl and *.BUILD overlay files in this directory
# form a Bazel package.

# Public framework access point for bundle-activator consumers: an alias to
# @celix//:framework so users get a working @celix transitively (via
# @rules_celix) without re-declaring the private celix_deps module extension,
# and without hardcoding the @celix repo name in their own BUILD files.
# Container runners embed the framework at rules_celix build time and never
# reference @celix from the consumer at all.
alias(
    name = "framework",
    actual = "@celix//:framework",
    visibility = ["//visibility:public"],
)
