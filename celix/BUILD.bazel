# celix/ — public API package
#
# User load path: @rules_celix//celix:defs.bzl

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")
load(":runtime.bzl", "celix_runtime")

package(default_visibility = ["//visibility:public"])

# `celix_version` is the manifest contract version only: it selects the
# MANIFEST.MF (properties, < 3.0.0) vs MANIFEST.json (JSON, >= 3.0.0) format
# (see the threshold in celix/internal/manifest.bzl). `framework` is the
# framework package label string selecting the framework binaries linked into
# bundles, defaulting to @rules_celix//third_party/celix. The two axes are
# orthogonal: `celix_version` never selects binaries and `framework` never
# selects a manifest format. A `celix_version` of 3.x changes only the
# manifest format.
celix_runtime(
    name = "default_runtime",
    celix_version = "2.4.0",
    visibility = ["//visibility:public"],
)

# Required by stardoc for transitive .bzl resolution.
bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "runtime_bzl",
    srcs = ["runtime.bzl"],
    deps = [":providers_bzl"],
)

bzl_library(
    name = "bundle_bzl",
    srcs = ["bundle.bzl"],
    deps = [
        "//celix/internal:bundle_impl_bzl",
        "//celix/internal:cc_bzl",
    ],
)

bzl_library(
    name = "container_bzl",
    srcs = ["container.bzl"],
    deps = [
        "//celix/internal:container_bzl",
        "//celix/internal:container_impl_bzl",
        "//celix/internal:container_tar_bzl",
        "//celix/internal:rules_cc_defs_bzl",
        "@bazel_skylib//rules:write_file",
    ],
)

stardoc(
    name = "celix_stardoc",
    out = "celix_api.html",
    input = "defs.bzl",
    deps = [
        ":bundle_bzl",
        ":container_bzl",
        ":providers_bzl",
        ":runtime_bzl",
        "//celix/internal:bundle_impl_bzl",
        "//celix/internal:cc_bzl",
        "//celix/internal:container_impl_bzl",
        "//celix/internal:container_tar_bzl",
        "//celix/internal:manifest_bzl",
        "//celix/internal:zip_bzl",
    ],
)
