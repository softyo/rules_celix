load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_celix//celix:defs.bzl", "celix_bundle", "celix_c_bundle", "celix_container", "celix_cpp_bundle", "celix_runtime")

package(
    default_testonly = True,
    default_visibility = ["//tests:__subpackages__"],
)

# The .C extension fixture is auto-declared as a source-file target by Bazel
# (unlike .cu/.mm/.M, which need exports_files and CUDA/ObjC++ toolchains),
# so no registration is needed here.

cc_library(
    name = "dummy_activator_lib",
    srcs = ["dummy_activator.c"],
    hdrs = ["dummy_activator.h"],
)

cc_shared_library(
    name = "dummy_lib",
    deps = [":dummy_activator_lib"],
)

cc_shared_library(
    name = "dummy_private_lib",
    deps = [":dummy_activator_lib"],
)

filegroup(
    name = "dummy_resources",
    srcs = [
        "config.txt",
        "configs/nested.txt",
    ],
)

celix_bundle(
    name = "test_bundle",
    activator = ":dummy_lib",
    bundle_name = "My Test Bundle",
    symbolic_name = "com.example.test",
    version = "1.2.3",
)

celix_bundle(
    name = "test_bundle_default_version",
    activator = ":dummy_lib",
    symbolic_name = "com.example.test_default",
)

celix_runtime(
    name = "celix_v3",
    celix_version = "3.0.0",
)

celix_bundle(
    name = "test_bundle_v3",
    activator = ":dummy_lib",
    bundle_name = "Test Bundle V3",
    celix = ":celix_v3",
    symbolic_name = "com.example.test_v3",
    version = "1.2.3",
)

celix_bundle(
    name = "test_bundle_full",
    activator = ":dummy_lib",
    bundle_name = "Full Test Bundle",
    description = "A full test bundle",
    filename = "custom_zip_name.zip",
    group = "com.example.group",
    headers = {
        "Custom-Header": "custom-value",
    },
    private_libs = [":dummy_private_lib"],
    resources = [":dummy_resources"],
    symbolic_name = "com.example.full",
    version = "2.0.0",
)

celix_bundle(
    name = "test_bundle_no_activator",
    no_activator = True,
    resources = [":dummy_resources"],
    symbolic_name = "com.example.no_activator",
)

celix_c_bundle(
    name = "macro_c_bundle",
    srcs = [
        "dummy_activator.c",
        "dummy_activator.h",
    ],
    bundle_name = "Macro C Bundle",
    symbolic_name = "com.example.macro_c",
)

celix_cpp_bundle(
    name = "macro_cpp_bundle",
    srcs = ["dummy_activator.cc"],
    bundle_name = "Macro CXX Bundle",
    copts = ["-std=c++17"],
    symbolic_name = "com.example.macro_cpp",
    version = "1.2.3",
)

celix_c_bundle(
    name = "macro_flags_bundle",
    srcs = [
        "flags_activator.c",
        "inc/flags_only_header.h",
    ],
    bundle_name = "Macro Flags Bundle",
    copts = ["-DENABLED_TEST=1"],
    includes = ["inc"],
    linkopts = ["-lm"],
    symbolic_name = "com.example.macro_flags",
)

# A bundle with the same symbolic name as :test_bundle, used by the
# duplicate-symbolic-name celix_container failure test.
celix_bundle(
    name = "test_bundle_dup",
    activator = ":dummy_lib",
    symbolic_name = "com.example.test",
)

celix_container(
    name = "test_container",
    bundles = {
        1: [":test_bundle"],
        2: [":test_bundle_no_activator"],
    },
)

# Renamed bundle: the zip itself is custom_zip_name.zip (via 'filename'), but
# the container must lay it out as bundles/com.example.full.zip because the
# symbolic name is the stable container identity.
celix_container(
    name = "test_container_renamed",
    bundles = {0: [":test_bundle_full"]},
)

# A non-testonly container fixture for the runner smoke test: py_test data
# targets cannot transitively depend on testonly targets. It is tagged manual
# so it is not built by `bazel build //...`. The dummy bundles are install-only
# (never started), keeping the smoke test hermetic and exercising the
# CELIX_AUTO_INSTALL path end-to-end.
celix_container(
    name = "test_container_runner_fixture",
    install_only = [
        ":test_bundle",
        ":test_bundle_no_activator",
    ],
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

# Multi-level + install-only fixture used by the config-content validation
# py_test (this package's default_testonly applies).
celix_container(
    name = "test_container_levels",
    bundles = {
        1: [":test_bundle"],
        2: [":test_bundle_no_activator"],
    },
    install_only = [":test_bundle_full"],
    visibility = ["//tests:__subpackages__"],
)

# A bundle whose symbolic name contains a space, used by the container's
# space-rejection analysis test (CELIX_AUTO_START_* values are
# space-separated, so symbolic names must be space-free).
celix_bundle(
    name = "test_bundle_space_name",
    activator = ":dummy_lib",
    symbolic_name = "com.example.space name",
)

# Real-Celix start-order fixtures for the runner start-order integration test:
# two bundles whose activators print fixed marker lines, assembled into a
# two-level container (1 < 2).  Like the runner smoke fixture they are
# testonly + manual (they link @celix//:framework), so `bazel build //...` is
# unaffected while bazel test //... still builds them via the integration test.
celix_c_bundle(
    name = "start_order_infra",
    srcs = ["start_order_infra.c"],
    symbolic_name = "com.example.start_order_infra",
    tags = ["manual"],
)

celix_c_bundle(
    name = "start_order_app",
    srcs = ["start_order_app.c"],
    symbolic_name = "com.example.start_order_app",
    tags = ["manual"],
)

celix_container(
    name = "test_container_start_order",
    bundles = {
        1: [":start_order_infra"],
        2: [":start_order_app"],
    },
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

# Real-Celix C++ start-order fixture (issue #13): a C++ activator using the
# celix::impl::createActivator path, auto-started by a container with the
# default framework = "runtime" link mode (headers-only), logging a fixed
# marker line. testonly + manual like the other real-Celix fixtures.
celix_cpp_bundle(
    name = "start_order_cxx",
    srcs = ["start_order_cxx.cc"],
    copts = ["-std=c++17"],
    symbolic_name = "com.example.start_order_cxx",
    tags = ["manual"],
)

celix_container(
    name = "test_container_start_cxx",
    bundles = {
        1: [":start_order_cxx"],
    },
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

# Static-link-mode fixtures for the container analysis guard tests.
#
# A C++ bundle with framework = "static" embeds its own compiled framework copy
# into the activator .so; auto-starting such a bundle inside a celix_container
# crashes in celix::impl::createActivator (issue #13), so the container rule
# rejects static-mode C++ bundles at start levels. Static-mode C bundles are
# fine (no C++ program state is duplicated) and static bundles may still be
# install_only (never started) in a container.
celix_cpp_bundle(
    name = "static_cpp_bundle",
    srcs = ["dummy_activator.cc"],
    copts = ["-std=c++17"],
    framework = "static",
    symbolic_name = "com.example.static_cpp",
    tags = ["manual"],
)

celix_c_bundle(
    name = "static_c_bundle",
    srcs = ["dummy_activator.c"],
    framework = "static",
    symbolic_name = "com.example.static_c",
    tags = ["manual"],
)

# A static-mode C++ bundle whose activator source uses a non-standard C++
# extension (.C); the container guard must reject it for auto-start like any
# other framework = "static" C++ bundle (regression for the extension
# allowlist broadening).
celix_cpp_bundle(
    name = "static_cpp_ext_bundle",
    srcs = ["dummy_activator_ext.C"],
    copts = ["-std=c++17"],
    framework = "static",
    symbolic_name = "com.example.static_cpp_ext",
    tags = ["manual"],
)
