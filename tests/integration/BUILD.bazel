load("//celix/internal:container.bzl", "container_runner_file_name")

package(default_testonly = True)

# Validates a celix_bundle zip at build time.
# Uses py_test so arguments are passed directly to Python with no intermediate
# shell, preserving spaces in bundle names like "My Test Bundle".
py_test(
    name = "validate_bundle_test",
    srcs = ["validate_bundle.py"],
    args = [
        "$(rootpath //tests/testdata:test_bundle)",
        "com.example.test",
        "1.2.3",
        "--format",
        "properties",
        "My Test Bundle",
    ],
    data = [
        "//tests/testdata:test_bundle",
    ],
    main = "validate_bundle.py",
)

py_test(
    name = "validate_bundle_default_name_test",
    srcs = ["validate_bundle.py"],
    args = [
        "$(rootpath //tests/testdata:test_bundle_default_version)",
        "com.example.test_default",
        "0.0.0",
        "--format",
        "properties",
    ],
    data = [
        "//tests/testdata:test_bundle_default_version",
    ],
    main = "validate_bundle.py",
)

py_test(
