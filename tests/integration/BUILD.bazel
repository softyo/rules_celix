py_test(
    name = "validate_bundle_full_test",
    srcs = ["validate_bundle.py"],
    args = [
        "$(rootpath //tests/testdata:test_bundle_full)",
        "com.example.full",
        "2.0.0",
        "--format",
        "properties",
        "Full Test Bundle",
        "--description",
        "A full test bundle",
        "--group",
        "com.example.group",
    ] + select({
        "@platforms//os:osx": [
            "--private-lib",
            "libdummy_private_lib.dylib",
            "--private-lib",
            "libdummy_lib.dylib",
        ],
        "//conditions:default": [
            "--private-lib",
            "libdummy_private_lib.so",
            "--private-lib",
            "libdummy_lib.so",
        ],
    }) + [
        # The activator shared library is also a private library of the bundle;
        # Celix lists it in Private-Library after the explicitly declared
        # private libs. The extension is platform-dependent (handled above).
        "--resource",
        "tests/testdata/config.txt",
        "--resource",
        "tests/testdata/configs/nested.txt",
        "--header",
        "Custom-Header",
        "custom-value",
    ],
    data = [
        "//tests/testdata:test_bundle_full",
    ],
    main = "validate_bundle.py",
)

