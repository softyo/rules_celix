# Validates a celix_container's bundle layout at build time.
# The container's bundle zips land at <package>/<name>_runtime/bundles/..., so
# `$(rootpath ...)` of the source bundles gives the package dir to check.
py_test(
    name = "validate_container_test",
    srcs = ["validate_container.py"],
    args = [
        "--container-name",
        "test_container",
        "--bundle",
        "$(rootpath //tests/testdata:test_bundle)",
        "com.example.test",
        "--bundle",
        "$(rootpath //tests/testdata:test_bundle_no_activator)",
        "com.example.no_activator",
    ],
    data = [
        "//tests/testdata:test_bundle",
        "//tests/testdata:test_bundle_no_activator",
        "//tests/testdata:test_container",
    ],
    main = "validate_container.py",
    deps = ["//tools:celix_zip_lib"],
)

# Boots a celix_container's runner hermetically: starts the embedded Celix
# framework from a writable copy of the generated config.properties + bundles/,
# waits for the fixed sentinel line, writes STOP_RUNNER=1, and asserts a clean
# exit 0.
#
# The runner copy is rule-internal (no <name>_runner target anymore); the test
# derives its path from the container name + the config rootpath:
# config sits at <pkg>/<name>_runtime/config.properties, the runner at
# <pkg>/<name>_runner.
py_test(
    name = "runner_smoke_test",
    timeout = "moderate",
    srcs = ["runner_smoke_test.py"],
    args = [
        "$(rootpath //tests/testdata:test_container_runner_fixture_config)",
        container_runner_file_name("test_container_runner_fixture"),
    ],
    data = [
        "//tests/testdata:test_container_runner_fixture",
        "//tests/testdata:test_container_runner_fixture_config",
    ],
    main = "runner_smoke_test.py",
)

# Asserts the exact body of the config.properties generated by a level-aware
# celix_container: static keys, then CELIX_AUTO_START_1/2 (ascending, no empty
# CELIX_AUTO_START_0 line), then CELIX_AUTO_INSTALL.
py_test(
    name = "validate_start_level_config_test",
    srcs = ["validate_start_level_config.py"],
    args = [
        "$(rootpath //tests/testdata:test_container_levels_config)",
    ],
    data = [
        "//tests/testdata:test_container_levels",
        "//tests/testdata:test_container_levels_config",
    ],
    main = "validate_start_level_config.py",
)

# Boots the two-level real-Celix container fixture and asserts the framework
# auto-starts the level-1 bundle before the level-2 bundle, then exits cleanly
# on STOP_RUNNER=1.
py_test(
    name = "runner_start_order_test",
    timeout = "moderate",
    srcs = ["runner_start_order_test.py"],
    args = [
        "$(rootpath //tests/testdata:test_container_start_order_config)",
        container_runner_file_name("test_container_start_order"),
    ],
    data = [
        "//tests/testdata:test_container_start_order",
        "//tests/testdata:test_container_start_order_config",
    ],
    main = "runner_start_order_test.py",
)

