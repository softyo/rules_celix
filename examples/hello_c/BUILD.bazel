"""C bundle example: a real Celix activator compiled against the hermetically
built `@celix//:framework` (headers-only; `framework = "runtime"` default —
inside a celix_container the activator's celix_* symbols bind against the
runner's single embedded framework at dlopen time).
"""

load("//celix:defs.bzl", "celix_c_bundle")

celix_c_bundle(
    name = "hello_bundle",
    srcs = ["src/hello_activator.c"],
    bundle_name = "Hello World Bundle",
    symbolic_name = "org.example.hello",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)
