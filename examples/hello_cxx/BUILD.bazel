"""C++ bundle example: a real Celix C++ activator compiled against the
hermetically built `@celix//:framework` (headers-only; `framework = "runtime"`
default — inside a celix_container the activator's celix_* symbols bind against
the runner's single embedded framework, which is what makes C++ auto-start
safe, see issue #13).
"""

load("//celix:defs.bzl", "celix_cpp_bundle")

celix_cpp_bundle(
    name = "hello_bundle",
    srcs = ["src/hello_activator.cc"],
    bundle_name = "Hello CXX Bundle",
    copts = ["-std=c++17"],
    symbolic_name = "org.example.hello_cxx",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)
