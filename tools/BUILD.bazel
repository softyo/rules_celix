"""Hermetic tools for Celix bundle packaging and container running."""

package(default_visibility = ["//celix:__subpackages__"])

py_library(
    name = "celix_zip_lib",
    srcs = ["celix_zip.py"],
    visibility = [
        "//celix:__subpackages__",
        "//tests:__subpackages__",
    ],
)

py_binary(
    name = "celix_zip",
    srcs = ["celix_zip.py"],
    main = "celix_zip.py",
    visibility = ["//celix:__subpackages__"],
)

# The container runner's C source, shared by every consumer package: the
# celix_container macro compiles it itself as a per-container <name>_runner
# cc_binary, linked against the container's chosen framework package (see
# celix/container.bzl). The source is framework-agnostic; only the consumer's
# link target supplies the embedded Celix framework.
exports_files(
    ["container_runner.c"],
    visibility = ["//visibility:public"],
)
